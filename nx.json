{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/.next"],
      "cache": true
    },
    "start": {
      "dependsOn": [
        "^start"
      ]
    },
    "codegen": {
      "dependsOn": [
        "^codegen"
      ],
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "eslint": {
      "cache": true
    },
    "stylelint": {
      "cache": true
    },
    "prettier": {
      "cache": true
    },
    "@nx/vitest:test": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "eslint:lint"
      }
    },
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": {
          "name": "docker:build"
        },
        "runTarget": {
          "name": "docker:run"
        }
      }
    }
  ],
  "nxCloudId": "69397d534c53f75acd410d25"
}
