{
  "family": "build-tool-test",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::750969166615:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "build-tool-test",
      "image": "750969166615.dkr.ecr.eu-north-1.amazonaws.com/build-tool-test:__IMAGE_TAG__"
    }
  ],
  "logConfiguration": {
  "logDriver": "awslogs",
  "options": {
    "awslogs-group": "/ecs/build-tool-test",
    "awslogs-region": "eu-north-1",
    "awslogs-stream-prefix": "ecs",
    "awslogs-create-group": "false"
    }
  }
}

