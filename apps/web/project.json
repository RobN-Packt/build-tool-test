{
    "name": "web",
    "root": "apps/web",
    "sourceRoot": "apps/web",
    "projectType": "application",
    "targets": {
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": [
                    "apps/web/**/*.{js,jsx,ts,tsx}"
