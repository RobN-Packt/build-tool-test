{
    "name": "web",
    "root": "apps/web",
    "sourceRoot": "apps/web",
    "projectType": "application",
    "targets": {
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": [
                    "apps/web/**/*.{js,jsx,ts,tsx}"
                ]
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm --filter book-web test"
            }
        },
        "build": {
            "executor": "@nx/next:build",
            "outputs": ["{projectRoot}/.next"],
            "options": {
                "root": "apps/web",
                "outputPath": "dist/apps/web"
            }
        }
    },
    "tags": []
}
